generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id               String       @id @default(uuid()) @db.Uuid
  fullName         String
  aliases          String?      // Tên tự, tên húy, biệt hiệu
  birthDate        DateTime?
  deathDate        DateTime?
  gender           String
  
  // Thông tin nguồn gốc & Bố mẹ (dành cho người không có trong cây chính)
  origin           String?      // Quê quán
  fatherName       String?      // Tên bố (nếu không tạo node cha)
  motherName       String?      // Tên mẹ (nếu không tạo node mẹ)
  
  // Vị trí gia đình
  familyOrder      Int?         // Vị trí (1 = con cả, 2 = con thứ hai...)

  // Cuộc đời & Sự nghiệp
  birthPlace       String?      // Nơi sinh
  deathPlace       String?      // Nơi mất
  restingPlace     String?      // Nơi an táng/phần mộ
  education        String?      // Học vấn
  career           String?      // Nghề nghiệp, chức vụ
  merits           String?      // Công đức, thành tựu
  notes            String?      // Ghi chú khác

  encryptedPhone   String?
  encryptedAddress String?
  userAccountId    String?      @unique @db.Uuid
  userAccount      UserAccount? @relation(fields: [userAccountId], references: [id])
  
  unions           UnionPerson[]
  childrenLinks    Child[]
}

model Union {
  id           String        @id @default(uuid()) @db.Uuid
  marriageDate DateTime?
  divorceDate  DateTime?
  status       String        // "Married, Divorced, Unmarried_Partners"
  
  persons      UnionPerson[]
  children     Child[]
}

model UnionPerson {
  unionId  String @db.Uuid
  personId String @db.Uuid
  role     String // "Husband, Wife, Unknown"
  
  union    Union  @relation(fields: [unionId], references: [id])
  person   Person @relation(fields: [personId], references: [id])
  
  @@id([unionId, personId])
}

model Child {
  unionId         String   @db.Uuid
  personId        String   @db.Uuid
  isAdopted       Boolean  @default(false)
  isAcknowledged  Boolean  @default(true)
  
  union           Union    @relation(fields: [unionId], references: [id])
  person          Person   @relation(fields: [personId], references: [id])
  
  @@id([unionId, personId])
}

model UserAccount {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         String   @default("Member")
  status       String   @default("Pending") // "Pending", "Active", "Rejected"
  mfaEnabled   Boolean  @default(false)
  
  person       Person?
}

model MediaArchive {
  id               String @id @default(uuid()) @db.Uuid
  uploaderId       String @db.Uuid
  fileUrl          String
  aesEncryptedKey  String
}

model Clan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   // Tên dòng họ
  progenitor      String?  // Thủy tổ
  origin          String?  // Nguồn gốc tổ tiên
  compilerName    String?  // Người biên soạn
  preface         String?  // Lời tựa
  
  branches        Branch[]
}

model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  clanId          String   @db.Uuid
  name            String   // Tên chi phái
  founderName     String?  // Người lập chi
  churchAddress   String?  // Địa chỉ nhà thờ chi
  
  clan            Clan     @relation(fields: [clanId], references: [id])
}
